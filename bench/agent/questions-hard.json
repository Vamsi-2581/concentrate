{
  "$comment": "Harder agent benchmark questions: each needs many files of internet-nest or an import-graph analysis. Expected answers were computed from the pinned source (import statements, decorators, process.env reads), not from Concentrate output; cycles count runtime imports only. Scoring as in questions.json.",
  "questions": [
    {
      "id": "nest-injector-cycles",
      "sample": "internet-nest",
      "category": "cycles",
      "question": "Which files in packages/core/injector take part in a runtime import cycle (type-only imports excluded)?",
      "expected": {
        "mustInclude": [
          "container.ts",
          "injector.ts",
          "instance-loader.ts",
          "instance-wrapper.ts",
          "module-ref.ts",
          "modules-container.ts"
        ]
      }
    },
    {
      "id": "nest-instance-wrapper-importers",
      "sample": "internet-nest",
      "category": "impact",
      "question": "If packages/core/injector/instance-wrapper.ts changes, which files in packages/core outside the injector directory import it directly? List them.",
      "expected": {
        "mustInclude": [
          "discovery-service.ts",
          "guards-context-creator.ts",
          "on-module-init.hook.ts",
          "graph-inspector.ts",
          "middleware-module.ts",
          "pipes-context-creator.ts",
          "routes-resolver.ts",
          "scanner.ts"
        ]
      }
    },
    {
      "id": "nest-microservices-client-cycle",
      "sample": "internet-nest",
      "category": "cycles",
      "question": "Which client implementations in packages/microservices/client are part of a runtime import cycle?",
      "expected": {
        "mustInclude": [
          "client-grpc.ts",
          "client-kafka.ts",
          "client-mqtt.ts",
          "client-nats.ts",
          "client-redis.ts",
          "client-rmq.ts",
          "client-tcp.ts",
          "client-proxy.ts"
        ]
      }
    },
    {
